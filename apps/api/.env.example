FM_ENV=dev                      # dev | test | staging | prod
FM_DATABASE_URL=postgresql://fm_app:CHANGE_ME@localhost:5432/fm_dev
FM_DATABASE_ADMIN_URL=postgresql://fm_owner:CHANGE_ME@localhost:5432/fm_dev
# python -m fm_seller.cli gen-key  → cole o resultado aqui. Guarde em cofre; perder a chave perde as credenciais.
FM_SECRETS_KEYS=
FM_GOOGLE_CLIENT_ID=            # obrigatório em staging/prod
FM_WEB_ORIGIN=http://localhost:3000
FM_PUBLIC_BASE_URL=http://localhost:8000
FM_COOKIE_SECURE=false          # true em staging/prod (HTTPS)
FM_PLATFORM_CAKTO_SECRET=       # segredo do webhook das compras do próprio SaaS (vazio = desligado)
FM_PLATFORM_HOTMART_HOTTOK=     # idem, Hotmart
FM_AI_API_KEY=                  # chave do Gemini da plataforma (vazio: simulador em dev, pessoa em prod)
FM_AI_MODEL=gemini-3.8-flash    # nome do modelo; confirmar com `cli ai-check`
FM_WHATSAPP_LIVE=false        # true só depois de validar com conta real da Meta (API e worker)
FM_META_GRAPH_VERSION=v26.0   # versão da Graph API
FM_AI_THINKING_LEVEL=low      # low | medium | high (o 3.8 Flash não aceita "minimal")
FM_CAPTURE_EVENTS=false       # true só para capturar eventos reais de checkout (docs/OPERACAO.md)
FM_CAPTURE_TTL_HOURS=72       # as capturas apagam sozinhas depois disso
FM_TENANT_DELETION_GRACE_DAYS=30  # carência entre pedir a exclusão da conta e apagar tudo
FM_CAPTURE_KEEP=100           # no máximo isto por origem
# Só para a primeira subida sem terminal (`cli bootstrap`, docs/STAGING_RENDER.md):
FM_BOOTSTRAP_APP_PASSWORD=    # senha NOVA do papel fm_app (só letras e números)
FM_BOOTSTRAP_OWNER_EMAIL=     # seu Gmail (dono do primeiro cliente)
FM_BOOTSTRAP_TENANT_NAME=     # nome do primeiro cliente
