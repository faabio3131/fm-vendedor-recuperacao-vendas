# URL pública da API (o navegador chama esta URL)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Client ID do login com Google (Google Cloud Console). Sem ele, só o login de desenvolvimento aparece.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 1 = mostra o login simulado. NUNCA ligar em staging/produção.
NEXT_PUBLIC_DEV_LOGIN=0
