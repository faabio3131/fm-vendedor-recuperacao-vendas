# Copie para /opt/fm-seller/.env no servidor e preencha. NUNCA coloque valores reais no repositório.
APP_HOST=app.atendevendeia.com.br
API_HOST=api.atendevendeia.com.br
ACME_EMAIL=contato@exemplo.com.br

# Senhas do banco: gere com `openssl rand -hex 24` (só letras e números, sem símbolos).
FM_OWNER_DB_PASSWORD=
FM_APP_DB_PASSWORD=

# Chave de cifragem das credenciais dos clientes: `docker compose run --rm api python -m fm_seller.cli gen-key`.
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela as credenciais dos clientes não abrem.
FM_SECRETS_KEYS=

FM_GOOGLE_CLIENT_ID=
FM_BOOTSTRAP_OWNER_EMAIL=
FM_BOOTSTRAP_TENANT_NAME=

# Opcionais (deixe vazio/desligado até a hora certa)
FM_PLATFORM_CAKTO_SECRET=
FM_PLATFORM_HOTMART_HOTTOK=
FM_AI_API_KEY=
FM_AI_MODEL=gemini-3.1-flash-lite
FM_WHATSAPP_LIVE=false
FM_VOICE_TRANSCRIPTION=false
FM_FMCOMMAND_MODE=off

# Backup: chave PÚBLICA do age (a privada fica só com o Diretor, fora do servidor).
AGE_RECIPIENT=
# Cópia fora da máquina (opcional, via rclone): nome do destino, ex.: offsite:fm-seller-backups
RCLONE_REMOTE=
# Aviso de falha (opcional): endereço de ping/alerta (ex.: healthchecks.io ou ntfy)
ALERT_URL=
