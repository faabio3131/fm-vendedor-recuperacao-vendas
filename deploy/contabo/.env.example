# Create /home/SaaS/atendevendeia/.env outside Git; chmod 600.
# Required variables intentionally blank to fail-closed until configured.
APP_HOST=app.atendevendeia.com.br
# Use the REAL Docker network to which existing Nginx Proxy Manager is attached.
# Discover with: docker inspect <npm-container> --format '{{json .NetworkSettings.Networks}}'
NPM_EDGE_NETWORK=
FM_OWNER_DB_PASSWORD=
FM_APP_DB_PASSWORD=
FM_SECRETS_KEYS=
FM_GOOGLE_CLIENT_ID=
FM_BOOTSTRAP_OWNER_EMAIL=
FM_BOOTSTRAP_TENANT_NAME=
# Optional; empty means disabled and MUST NOT be misrepresented as ready.
FM_PLATFORM_CAKTO_SECRET=
FM_PLATFORM_HOTMART_HOTTOK=
FM_AI_API_KEY=
FM_AI_MODEL=gemini-3.1-flash-lite
FM_FMCOMMAND_MODE=off
# There is NO Evolution adapter enabled in this canonical product yet.
# FM_WHATSAPP_LIVE stays false in production until officially supported and proven.

# Keep false until validated against actual NPM/Next.js/API network peers.
FM_TRUST_PROXY=false
FM_TRUSTED_PROXY_CIDRS=
